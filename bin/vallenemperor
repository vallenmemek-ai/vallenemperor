#!/usr/bin/env node
'use strict'
/**
 * Portable launcher: replaces the old bash wrapper so the CLI starts the same way
 * on Linux, macOS, Termux and Windows. npm's bin shim reads this shebang and
 * generates the matching .cmd on Windows.
 */
const { spawn } = require('node:child_process')
const { existsSync } = require('node:fs')
const { dirname, join, resolve } = require('node:path')

const repoRoot = resolve(dirname(__filename), '..')
const cliEntry = join(repoRoot, 'vallencli', 'src', 'cli.mjs')
const coreBuild = join(repoRoot, 'vallenagent', 'dist', 'index.js')

if (!existsSync(coreBuild)) {
  console.error('VallenAgent core build missing. Run: npm -w vallenagent run build')
  process.exit(1)
}
if (!existsSync(cliEntry)) {
  console.error(`VallenCLI entry not found: ${cliEntry}`)
  process.exit(1)
}

const child = spawn(process.execPath, [cliEntry, ...process.argv.slice(2)], { stdio: 'inherit' })
// The terminal delivers Ctrl+C to the whole process group; the launcher only waits.
for (const signal of ['SIGINT', 'SIGTERM', 'SIGHUP']) process.on(signal, () => {})
child.on('error', error => {
  console.error(`VallenCLI failed to start: ${error.message}`)
  process.exit(1)
})
child.on('exit', (code, signal) => {
  process.exit(code ?? (signal ? 1 : 0))
})

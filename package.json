{
  "name": "vallenemperor",
  "version": "999.999.1001",
  "description": "Autonomous AI agent core and terminal CLI (VallenEmperor)",
  "bin": {
    "vallenemperor": "vallencli/src/cli.mjs",
    "vallenemperorcli": "vallencli/src/cli.mjs"
  },
  "files": [
    "vallencli/src/",
    "vallencli/package.json",
    "vallenagent/dist/",
    "banner.txt",
    "README.md",
    "LICENSE",
    ".vallenemperor/skills/"
  ],
  "workspaces": [
    "vallenagent",
    "vallencli"
  ],
  "scripts": {
    "build": "npm --prefix vallenagent run build && npm --prefix vallencli run build",
    "typecheck": "npm -w vallenagent run typecheck",
    "cli": "npm -w vallenagent run build && npm -w vallencli run start",
    "test": "npm -w vallenagent run test && npm -w vallencli run test",
    "prepack": "npm run build",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "axios": "^1.20.0",
    "glob": "^10.3.0",
    "openai": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "11.10.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agent",
    "cli",
    "autonomous-agent",
    "llm",
    "terminal"
  ],
  "author": "vallenganteng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vallenmemek-ai/vallenemperor.git"
  },
  "homepage": "https://github.com/vallenmemek-ai/vallenemperor#readme",
  "bugs": {
    "url": "https://github.com/vallenmemek-ai/vallenemperor/issues"
  }
}
